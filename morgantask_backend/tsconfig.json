{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "lib": [
            "esnext"
        ],
        "target": "ESNext",
        "moduleResolution": "Node",
        "module": "commonjs",
        "strict": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "declaration": false,
        "baseUrl": ".",
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}