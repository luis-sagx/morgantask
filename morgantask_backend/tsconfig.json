{
    "compilerOptions": {
        
        "outDir": "./dist",
        "rootDir": "./src",
        "lib": [
            "esnext"
        ],
        "target": "ESNext",
"moduleResolution": "NodeNext",
"types": ["node", "jest"],
"module": "NodeNext",
"strict": false,
"sourceMap": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "declaration": false,
        "baseUrl": ".",
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}